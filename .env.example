NEXT_PUBLIC_APP_NAME=BLUEPRINT BUDDIES
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase web SDK (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheets / Drive service account. Can be same Google Cloud project if configured.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Comma-separated Firebase-authenticated admin emails
ADMIN_EMAILS=

# Beta controls
NEXT_PUBLIC_BETA_MODE=true
DEFAULT_MAX_CLAIMS=3
