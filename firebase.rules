rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All application business data is server-side only. Browser clients authenticate
    // with Firebase Auth, then call protected Next.js API routes. The Admin SDK bypasses
    // Firestore rules only on trusted server infrastructure.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
